#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT=${DORA_PROJECT:-}
HOST=${DORA_HOST:-127.0.0.1}
IDE_URL=${DORA_IDE_URL:-http://localhost:8866/}

usage() {
	cat <<'EOF'
Usage: DORA_PROJECT=/absolute/project ./dora-lab [dev|start|install|build|run|buildrun|status|log|stop]

  dev       Rebuild TypeScript and run (for Coding Agents)
  start     Start the Dora SSR engine
  install   Install TypeScript API definitions in the selected project
  build     Compile the selected TypeScript/TSX project to Lua
  run       Run the already-built project (default)
  buildrun  Install definitions if needed, then build and run
  status    Show the Dora engine/Web IDE/project status
  log       Show recent Dora logs
  stop      Stop the running Dora project
EOF
}

require_dora() {
	if ! command -v Dora >/dev/null 2>&1; then
		echo "Dora CLI was not found. Install Dora SSR 1.9.2+ and add Dora to PATH." >&2
		exit 127
	fi
}

require_project() {
	if [ -z "$PROJECT" ]; then
		if [ -f "$PWD/init.tsx" ] || [ -f "$PWD/init.ts" ] || [ -f "$PWD/init.lua" ]; then
			PROJECT=$PWD
		else
			echo "Set DORA_PROJECT to the Dora project directory, or run this command inside that directory." >&2
			exit 2
		fi
	fi
	if [ ! -d "$PROJECT" ]; then
		echo "Dora project directory does not exist: $PROJECT" >&2
		exit 2
	fi
	PROJECT=$(CDPATH= cd -- "$PROJECT" && pwd)
}

open_url() {
	case "$(uname -s)" in
		Darwin) open -g "$1" >/dev/null 2>&1 ;;
		Linux) command -v xdg-open >/dev/null 2>&1 && xdg-open "$1" >/dev/null 2>&1 || true ;;
	esac
}

engine_ready() {
	Dora cli status --host "$HOST" 2>/dev/null | grep -q "Native engine: yes"
}

start_engine() {
	if ! engine_ready; then
		case "$(uname -s)" in
			Darwin) open -a Dora >/dev/null 2>&1 ;;
		esac
	fi

	i=0
	while ! engine_ready; do
		i=$((i + 1))
		if [ "$i" -ge 30 ]; then
			echo "Dora SSR did not become ready at $HOST:8866." >&2
			exit 1
		fi
		sleep 0.2
	done
	echo "Dora SSR is ready."
}

start_compiler() {
	start_engine

	# Give a previously opened IDE tab a moment to reconnect before opening one.
	i=0
	while ! Dora cli status --host "$HOST" 2>/dev/null | grep -q "Web IDE connected: yes"; do
		i=$((i + 1))
		[ "$i" -ge 10 ] && break
		sleep 0.2
	done
	if ! Dora cli status --host "$HOST" 2>/dev/null | grep -q "Web IDE connected: yes"; then
		# A unique query forces an existing stale IDE tab to reconnect its socket.
		open_url "${IDE_URL}?connect=$(date +%s)"
		i=0
		while ! Dora cli status --host "$HOST" 2>/dev/null | grep -q "Web IDE connected: yes"; do
			i=$((i + 1))
			if [ "$i" -ge 75 ]; then
				echo "Dora Web IDE did not connect at $IDE_URL." >&2
				exit 1
			fi
			sleep 0.2
		done
	fi
	echo "Dora TypeScript compiler is ready."
}

install_api() {
	Dora cli ts install -p "$PROJECT" -l en --host "$HOST"
}

build_project() {
	output=$(Dora cli build -p "$PROJECT" --host "$HOST" 2>&1) || {
		printf '%s\n' "$output" >&2
		exit 1
	}
	printf '%s\n' "$output"
	if printf '%s\n' "$output" | grep -q '^\[error\]'; then
		exit 1
	fi
	if [ ! -f "$PROJECT/init.lua" ]; then
		echo "Dora did not generate $PROJECT/init.lua." >&2
		exit 1
	fi
}

require_dora
command=${1:-}
case "$command" in
	dev)
		require_project
		start_compiler
		[ -f "$PROJECT/API/Dora.d.ts" ] || install_api
		build_project
		Dora cli run -p "$PROJECT" --host "$HOST"
		sleep 0.5
		if Dora cli log -n 40 --host "$HOST" | grep -q "BUTTON_LAB_SELF_TEST_OK"; then
			echo "Dora project is built and running: $PROJECT"
		fi
		;;
	start)
		start_engine
		;;
	install)
		require_project
		install_api
		;;
	build)
		require_project
		start_compiler
		[ -f "$PROJECT/API/Dora.d.ts" ] || install_api
		build_project
		;;
	buildrun)
		require_project
		start_compiler
		[ -f "$PROJECT/API/Dora.d.ts" ] || install_api
		build_project
		Dora cli run -p "$PROJECT" --host "$HOST"
		;;
	run|"")
		require_project
		start_engine
		if [ ! -f "$PROJECT/init.lua" ]; then
			echo "Compiled runtime is missing; rebuilding the project once." >&2
			start_compiler
			[ -f "$PROJECT/API/Dora.d.ts" ] || install_api
			build_project
		fi
		Dora cli run -p "$PROJECT" --host "$HOST"
		echo "Dora project is running: $PROJECT"
		;;
	status)
		Dora cli status --host "$HOST"
		;;
	log)
		Dora cli log -n "${DORA_LOG_LINES:-100}" --host "$HOST"
		;;
	stop)
		Dora cli stop --host "$HOST"
		;;
	-h|--help|help)
		usage
		;;
	*)
		echo "Unknown command: $command" >&2
		usage >&2
		exit 2
		;;
esac
